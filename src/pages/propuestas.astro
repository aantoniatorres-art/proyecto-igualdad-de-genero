---
import Layout from "../layout/Layouts.astro";
import Hero from "../components/Hero.astro";
import Card from "../components/Card.astro";
---

<Layout
    title="Propuestas de Cambio - Igualdad ETP"
    description="Acciones clave, orientación vocacional inclusiva y recursos para transformar la educación técnico-profesional."
>
    <Hero
        badge="Estrategias y Soluciones"
        title="Propuestas de Cambio y Recursos"
        subtitle="Medidas concretas para instituciones educativas, docentes y empresas comprometidas con la equidad de género."
    />

    <section aria-labelledby="proposals-title">
        <h2 id="proposals-title">Líneas de Acción Prioritarias</h2>

        <div class="grid-cards">
            <Card
                icon="👩‍🏫"
                tag="Pedagogía"
                title="Docencia con Enfoque de Género"
                description="Capacitación docente continua para eliminar sesgos inconscientes en el aula y promover lenguaje e interacciones equitativas."
            />
            <Card
                icon="🎓"
                tag="Mentorías"
                title="Red de Referentes Femeninas"
                description="Conectar a estudiantes de especialidades STEM e industriales con egresadas y profesionales destacadas del sector."
            />
            <Card
                icon="🔍"
                tag="Orientación"
                title="Orientación Vocacional Temprana"
                description="Ferias e hitos vocacionales dirigidos a estudiantes de enseñanza básica para explorar todas las ramas técnicas sin prejuicios."
            />
            <Card
                icon="🤝"
                tag="Empresa"
                title="Alianzas con Compromiso Inclusivo"
                description="Convenios de práctica laboral con empresas que aseguren ambientes seguros, libres de acoso y con igualdad de condiciones."
            />
        </div>
    </section>

    <section class="resources-section" aria-labelledby="resources-title">
        <h2 id="resources-title">Recursos e Instrumental Pedagógico</h2>
        <div class="resources-grid">
            <article class="resource-item">
                <h3>Guía para una Orientación Vocacional Inclusiva</h3>
                <p>
                    Herramientas para equipos directivos y orientadores para
                    promover elecciones libres de estereotipos de género.
                </p>
                <span class="file-type">Documento de Recomendaciones (PDF)</span
                >
            </article>

            <article class="resource-item">
                <h3>Protocolo de Prevención de Acoso en Talleres</h3>
                <p>
                    Orientaciones prácticas para resguardar la convivencia
                    escolar en entornos prácticos e industriales.
                </p>
                <span class="file-type">Pauta Institucional</span>
            </article>
        </div>
    </section>
</Layout>

<style>
    .resources-section {
        margin-top: 2.5rem;
    }

    .resources-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-top: 1rem;
    }

    .resource-item {
        background-color: var(--color-surface);
        border-left: 4px solid var(--color-secondary);
        border-top: 1px solid var(--color-border);
        border-right: 1px solid var(--color-border);
        border-bottom: 1px solid var(--color-border);
        padding: 1.5rem;
        border-radius: 4px 12px 12px 4px;
        box-shadow: var(--shadow);
    }

    .resource-item h3 {
        font-size: 1.1rem;
        color: var(--color-text);
    }

    .file-type {
        display: inline-block;
        margin-top: 0.75rem;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--color-secondary);
        text-transform: uppercase;
    }
</style>
